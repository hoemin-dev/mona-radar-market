{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "../dist-collector",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["koneps/**/*.ts", "storage/**/*.ts", "normalization/**/*.ts", "orchestration/**/*.ts"]
}
